# Configuration for the firebase/storage-resize-images extension.
#
# Purpose: grid cards render at roughly 260x200 but were served the original
# archival scans — measured at 33 MB for one 4374x6002 PNG. This generates small
# variants beside each upload so cards can load those instead.
#
# This instance is configured to process NEW uploads only. Version 0.2.10 does
# offer a native backfill (DO_BACKFILL below) — an earlier version of this comment
# claimed otherwise, having read the extension's main branch, where the feature is
# commented out. It is present in the published 0.2.10.
#
# We deliberately do not use it. See DO_BACKFILL for why.

LOCATION=us-central1
IMG_BUCKET=sahs-archives.firebasestorage.app

# 400 covers grid cards (~260px, allowing for 2x displays); 1000 covers the
# detail page's inline view without touching the full-resolution original.
# Must stay in sync with THUMB_SIZES in src/lib/imageThumbs.ts.
IMG_SIZES=400x400,1000x1000

# Originals are the archival record. Never delete them.
DELETE_ORIGINAL_FILE=false

# Off. Variants start restricted and are made public only if the item they
# belong to is public.
#
# This used to be true, on the reasoning that a public variant needs no signature
# or token, which is what lets the client derive a thumbnail URL from the
# original's path (37 of every 40 stored URLs are signed links whose signature
# can't be reused for a different object). But it made EVERY variant public,
# including 400px and 1000px copies of private items' scans — the extension
# cannot consult Firestore, the same reason DO_BACKFILL is off below. A private
# item's original returned 403 while its thumbnails returned 200.
#
# Public variants are still served exactly as src/lib/imageThumbs.ts expects:
# functions/mediaVisibility.js makes a public item's thumbnails public by ACL
# when the item is written (waiting briefly for ones still being resized), and
# scripts/reconcile-media-visibility.cjs gives every thumbnail its original's
# visibility. A thumbnail not yet made public 403s and OptimizedImage falls back
# to the original.
#
# Changing this file does not change the installed extension, and the CI deploy
# does not include extensions. Do NOT apply it with `firebase deploy --only
# extensions`: firebase.json's manifest lists only this instance, so that deploy
# treats the project's other installed extensions (firestore-send-email,
# storage-extract-image-text, firestore-algolia-search) as deletions, and
# `--only extensions:storage-resize-images` is rejected by firebase-tools 15.
# Change the setting in the Firebase console (Extensions -> Resize Images ->
# Reconfigure), then update this file to match. `firebase ext:configure` is not
# a substitute: it only rewrites this file. See CLAUDE.md's Gotchas.
MAKE_PUBLIC=false

# Written beside the original: archive_media/x.png -> archive_media/thumbs/x_400x400.webp
# Must stay in sync with RESIZED_DIR in src/lib/imageThumbs.ts.
RESIZED_IMAGES_PATH=thumbs

# Only the paths that hold publicly readable imagery (see storage.rules).
#
# accession_paperwork is deliberately excluded: it is staff-only, and public
# thumbnails of it would leak restricted material. content_images, portraits,
# posts and public belong to the sahs-website app sharing this bucket.
#
# There is no top-level /library_covers — book covers upload to
# archive_media/library_covers/, so /archive_media already covers them. An
# earlier version of this list named it anyway, which matched nothing.
INCLUDE_PATH_LIST=/archive_media,/collections,/additional_media,/site_assets

FAILED_IMAGES_PATH=failed

# Variants are derived and immutable for a given original.
CACHE_CONTROL_HEADER=public, max-age=31536000, immutable

IMAGE_TYPE=webp
IS_ANIMATED=false

# Source images run to tens of megapixels, so give the resizer real headroom.
# This is a select param whose allowed values are the raw megabyte numbers
# (512 / 1024 / 2048 / 4096 / 8192) — "2GB" is only the display label and fails
# validation.
FUNCTION_MEMORY=2048

# Required param, and one worth setting explicitly rather than relying on the
# default. Filtering routes every upload through a Gemini model, which costs money,
# adds latency, and — for a historical archive — risks an automated judgement
# rejecting legitimate historical photographs. Curators already review every
# accession by hand.
CONTENT_FILTER_LEVEL=OFF

# No download token on variants. A token bypasses storage.rules entirely, so one
# on a private item's thumbnail would be a public link to it; public variants are
# served by ACL and need none. Leaving the default would mint one per variant.
REGENERATE_TOKEN=false

# Required param. Off, and not because the alternative is unavailable — it works in
# 0.2.10 — but because it resizes everything under INCLUDE_PATH_LIST with no way to
# consult Firestore. archive_media/ holds the scans of items marked is_private and
# of items in private collections, and with MAKE_PUBLIC=true (as it was) it would
# publish token-free copies of them at derivable paths. Item privacy is a Firestore
# property; a path list cannot express it.
#
# scripts/backfill-thumbnails.cjs does the same job and reads archive_items and
# collections first so it can skip non-public media. That is the only reason it
# exists.
DO_BACKFILL=false
