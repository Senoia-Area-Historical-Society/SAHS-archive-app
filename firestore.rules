rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function for admin/curator roles.
    //
    // The role claim (set by functions/userRoles.js from this same user_roles
    // collection) is checked first as a fast path that skips the get() below
    // once a session has picked it up — it's also the only signal Storage
    // Rules have, since they can't reach this named database the way this
    // get()/exists() pair can.
    function isSAHSUser() {
      return request.auth != null &&
        request.auth.token.email != null && (
          // `.get()` rather than `.role`: most tokens carry no role claim, and
          // reading a missing property is an error, not false. Inside `||` that
          // happened not to matter, but it made isSAHSUser() unusable as a
          // condition — expectedCommentRole()'s ternary denied every member.
          request.auth.token.get('role', '') in ['admin', 'curator'] ||
          // The bare-domain clause was removed here. It granted curator-equivalent
          // write on archive_items, collections, settings, members, rooms and
          // locations to ANY @senoiahistory.com account the moment it signed in —
          // a new volunteer, an intern, someone mid-offboarding — with no role
          // grant and no audit trail. The sibling sahs-website repo refuses to do
          // this and says so in its own rules; the two apps share one Auth instance
          // and had opposite policies on the same identities.
          //
          // Safe to remove because every @senoiahistory.com account in Auth now
          // holds a user_roles document or is a support admin (enumerated
          // 2026-09-05), and the role claims those documents imply were
          // backfilled by scripts/backfill-role-claims.cjs.
          isSupportAdmin() ||
          (exists(/databases/$(database)/documents/user_roles/$(request.auth.token.email.lower())) &&
           get(/databases/$(database)/documents/user_roles/$(request.auth.token.email.lower())).data.role in ['admin', 'curator'])
        );
    }

    // Helper function for support admins: the archive's developers, admitted as
    // admins so they can help with support. An exact list of addresses in
    // deployment_config/support, written by scripts/set-support-admins.cjs. It
    // replaces two addresses that used to be hardcoded into this file, which no
    // museum installing the code could see or remove. Admin Settings shows it.
    function isSupportAdmin() {
      return request.auth != null &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/deployment_config/support) &&
        request.auth.token.email.lower() in
          get(/databases/$(database)/documents/deployment_config/support).data.get('emails', []);
    }

    // Helper function for admins specifically — the people who may grant roles.
    function isArchiveAdmin() {
      return request.auth != null &&
        request.auth.token.email != null && (
          request.auth.token.get('role', '') == 'admin' ||  // see isSAHSUser()
          isSupportAdmin() ||
          (exists(/databases/$(database)/documents/user_roles/$(request.auth.token.email.lower())) &&
           get(/databases/$(database)/documents/user_roles/$(request.auth.token.email.lower())).data.role == 'admin')
        );
    }

    // Helper function for setup check
    function isSetupComplete() {
      return (exists(/databases/$(database)/documents/site_settings/setup) &&
             get(/databases/$(database)/documents/site_settings/setup).data.isComplete == true) ||
             exists(/databases/$(database)/documents/site_settings/appearance);
    }

    // Helper function for who may run first-run setup.
    //
    // An exact list of addresses in deployment_config/bootstrap, written by
    // whoever installs the archive with scripts/set-setup-admins.cjs. It used to
    // be a hardcoded @senoiahistory.com match, which tied first-run setup to this
    // one society and made the code unusable for any other museum.
    //
    // A list of addresses rather than a domain on purpose: a museum on Gmail would
    // otherwise have to allow gmail.com, i.e. everyone. With no config document,
    // nobody can bootstrap — it fails closed.
    function isBootstrapAdmin() {
      return request.auth != null &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/deployment_config/bootstrap) &&
        request.auth.token.email.lower() in
          get(/databases/$(database)/documents/deployment_config/bootstrap).data.emails;
    }

    // Helper function to check if user is an active member
    function isActiveMember() {
      return request.auth != null &&
        request.auth.token.email != null &&
        isActiveMemberAddress(request.auth.token.email.lower());
    }

    // Whether an arbitrary address is an active member — the body of
    // isActiveMember(), split out so folder sharing can ask it about the address
    // being shared WITH rather than the signed-in user. Members are keyed by
    // lowercased address (the document id), so `email` must already be lowercase.
    function isActiveMemberAddress(email) {
      return exists(/databases/$(database)/documents/members/$(email)) &&
        get(/databases/$(database)/documents/members/$(email)).data.status == 'active' &&
        (
          get(/databases/$(database)/documents/members/$(email)).data.expiresAt == 'Never' ||
          get(/databases/$(database)/documents/members/$(email)).data.expiresAt >=
            string(request.time.year()) + '-' +
            (request.time.month() < 10 ? '0' + string(request.time.month()) : string(request.time.month())) + '-' +
            (request.time.day() < 10 ? '0' + string(request.time.day()) : string(request.time.day()))
        );
    }

    // Whether an arbitrary address holds a staff role — a user_roles document or
    // a place on the support list. The address-based counterpart of isSAHSUser(),
    // without its claim fast path: a claim belongs to the signed-in token, and
    // here we are asking about somebody else.
    function isStaffAddress(email) {
      return (exists(/databases/$(database)/documents/user_roles/$(email)) &&
              get(/databases/$(database)/documents/user_roles/$(email)).data.role in ['admin', 'curator']) ||
        (exists(/databases/$(database)/documents/deployment_config/support) &&
         email in get(/databases/$(database)/documents/deployment_config/support).data.get('emails', []));
    }

    // Whether a research_folders write adds only collaborators who may have one.
    //
    // Folders are shareable only with members (or staff). The check used to live
    // only in MyResearch.tsx, in the browser — and that check still waved through
    // any @senoiahistory.com address after the domain grant was removed — so any
    // client could share a folder, and every note in it marked shared, with any
    // Google account at all.
    //
    // Rules cannot loop over a list, so a write may add at most ONE new address,
    // and it must be the last element of `sharedWith` (where arrayUnion and the
    // client's append both put it): Sets have no way to hand back their single
    // element, so the rule names it by position and confirms it IS the addition.
    // Removing collaborators is unrestricted here; who may change `sharedWith` at
    // all is decided by the update rule below.
    function sharedWithAdditionsAllowed() {
      return !('sharedWith' in request.resource.data.diff(resource.data).affectedKeys()) ||
        sharedWithAdditionAllowed(
          request.resource.data.sharedWith.toSet().difference(resource.data.get('sharedWith', []).toSet()),
          request.resource.data.sharedWith);
    }

    function sharedWithAdditionAllowed(added, after) {
      return added.size() == 0 || (
        added.size() == 1 &&
        added.hasAll([after[after.size() - 1]]) &&
        (isActiveMemberAddress(after[after.size() - 1]) || isStaffAddress(after[after.size() - 1]))
      );
    }

    // The label a new comment must carry, from the writer's REAL role. The client
    // used to choose it freely, so any member could post as 'Admin' or 'Curator'
    // — on a public item, under someone else's name, since authorEmail was not
    // checked either. The order matches AuthContext + ItemDetail: an admin
    // (role or support list) is 'Admin', other staff 'Curator', everyone else
    // 'Member'.
    function expectedCommentRole() {
      return isArchiveAdmin() ? 'Admin' : (isSAHSUser() ? 'Curator' : 'Member');
    }

    // Helper function to check if user has access to a folder
    function isFolderOwnerOrCollaborator(folderId, userEmail) {
      return exists(/databases/$(database)/documents/research_folders/$(folderId)) && (
        get(/databases/$(database)/documents/research_folders/$(folderId)).data.get('ownerEmail', '').lower() == userEmail ||
        userEmail in get(/databases/$(database)/documents/research_folders/$(folderId)).data.get('sharedWith', [])
      );
    }

    // user_roles collection: admins/curators can read, admins can write roles, OR first user during setup
    match /user_roles/{email} {
      // `get` was `request.auth != null`, which let ANY Google account — a personal
      // Gmail, anyone on the internet who signs in — read any role document by
      // address and learn who holds admin or curator. Three callers actually need
      // it, and each is covered below:
      //   • AuthContext reads the signed-in user's own document (self).
      //   • Admin Settings lists them (`list`, already isSAHSUser()).
      //   • MyResearch checks a share target's role before adding a collaborator
      //     (src/pages/MyResearch.tsx ~445) — hence isActiveMember(), since only
      //     an active member can share a folder in the first place.
      // Note get()/exists() inside rules are privileged reads and do NOT re-enter
      // these rules, so isActiveMember() here is not recursive.
      allow get: if isSAHSUser()
                 || (request.auth != null && request.auth.token.email.lower() == email.lower())
                 || isActiveMember();
      allow list: if isSAHSUser();
      // Only the two hardcoded addresses could write here, so a museum's own
      // admins could not grant a curator role in Admin Settings, and a museum that
      // removed support access could never grant a role again. Any admin may now,
      // and only to the two roles that exist.
      allow delete: if isArchiveAdmin();
      allow create, update: if request.auth != null && (
        (isArchiveAdmin() && request.resource.data.role in ['admin', 'curator']) ||
        // First-run bootstrap: the initial admin grants themselves the role via
        // SetupWizard (src/pages/SetupWizard.tsx:182) before any admin exists.
        //
        // The isBootstrapAdmin() check is load-bearing: this clause is reachable
        // by ANY authenticated account whenever isSetupComplete() is false, so
        // without it anyone on the internet with a Google account could write
        // user_roles/{their own email} = admin and take over the archive. The whole
        // boundary is the existence of site_settings/setup or site_settings/appearance
        // (see isSetupComplete), which is far too thin a thread for a self-service
        // admin grant. Restricting it to the installer's list keeps first-run
        // working while making the clause unreachable from an arbitrary account.
        (!isSetupComplete()
         && request.auth.token.email.lower() == email.lower()
         && isBootstrapAdmin()
         && request.resource.data.role == 'admin')
      );
    }

    // archive_items collection: public items readable by anyone, staff read all
    //
    // Privacy used to be enforced only in the browser — BrowseArchive and
    // SearchArchive downloaded the whole collection and filtered private items out
    // in JavaScript — so anyone querying Firestore directly read everything.
    //
    // Two things had to land before this rule could: the backfill in
    // scripts/migrate-item-privacy-and-paperwork.cjs (only 231 of 1,533 items
    // carried `is_private`, and Firestore does not match documents where a field
    // is absent), and the query filters in src/lib/privacyQuery.ts with their
    // composite indexes. A list query that does not constrain `is_private` is now
    // REJECTED — so any new public query must carry `...publicOnly(isSAHSUser)`
    // and, if it combines that with an orderBy or array-contains, an index in
    // firestore.indexes.json.
    //
    // A DIRECT field read, deliberately — `resource.data.get('is_private', false)`
    // does not work here and the difference is not cosmetic. Firestore evaluates a
    // list query against the constraints the query carries, not against the
    // documents it would return; it can only tie a rule to a query when the rule
    // compares a field directly. Behind a map `.get()` the analyser cannot make
    // that link, so it stops requiring the query to filter at all — an unfiltered
    // list is then ALLOWED and every private item comes back. The first version of
    // this rule used `.get()` for leniency toward documents missing the field and
    // silently defeated itself; `src/test/firestore.rules.test.ts` catches it.
    //
    // The cost is that a document with no `is_private` field is denied to the
    // public rather than treated as public. That is the right direction for a
    // privacy rule, and it is not hypothetical safety: all 1,533 items and 4
    // collections carry the field after the backfill, and AddItem, AddCollection
    // and EditCollection all write it. Staff are unaffected either way.
    match /archive_items/{item} {
      allow read: if resource.data.is_private == false || isSAHSUser();
      allow write: if isSAHSUser();

      // Accession paperwork lives here rather than on the parent document.
      //
      // `accession_paperwork_urls` is "Admin/Curator only scans of paperwork"
      // (src/types/database.ts:169) and is rendered in no public view — only
      // EditItem reads it back, and that page is staff-only. On the parent it was
      // world-readable, publishing the storage paths of donor and provenance
      // scans to anyone. A path is inert while storage.rules is default-deny, but
      // becomes a working download the moment the sibling app's blanket
      // `allow read: if true` is the deployed Storage ruleset (see audit C1) —
      // which is exactly the kind of coupling that should not exist.
      match /provenance/{doc} {
        allow read, write: if isSAHSUser();
      }
    }

    // library_books collection: Anyone can read, only SAHS users can write
    match /library_books/{bookId} {
      allow read: if true;
      allow write: if isSAHSUser();
    }

    // comments subcollection under archive_items: readable when the item is,
    // only active members and curators can post
    //
    // Subcollections do not inherit the parent's rule, so this needed closing
    // separately: a private item's comments were public, which discloses both the
    // item's existence and the commenters' names. The get() is one document access
    // per query (rules cache it within an evaluation), well inside the limit.
    match /archive_items/{itemId}/comments/{commentId} {
      allow read: if isSAHSUser() ||
        get(/databases/$(database)/documents/archive_items/$(itemId)).data.is_private == false;
      // Create used to check only "staff or active member", and trusted every
      // field the client sent. A member could therefore post under someone else's
      // address (which also let that person delete it — see delete below), wear
      // an 'Admin' or 'Curator' badge, choose their own moderation status, and
      // comment on a private item they cannot even read. Each clause closes one:
      //   • authorEmail is the signed-in address, as ItemDetail.tsx writes it.
      //   • role is the writer's real role — expectedCommentRole() above.
      //   • status: ItemDetail writes 'approved' for every new comment and reply
      //     and nothing ever updates it (there is no update rule), so that is the
      //     only value a non-staff writer may set. Staff are left free so that a
      //     future moderation flow can be built without loosening this rule.
      //   • a member may only comment on an item they can read: a public one.
      // The parent get() is the same document read rules already do for `read`.
      allow create: if request.auth != null &&
        request.auth.token.email != null &&
        request.resource.data.authorEmail == request.auth.token.email.lower() &&
        request.resource.data.role == expectedCommentRole() && (
          isSAHSUser() || (
            isActiveMember() &&
            request.resource.data.status == 'approved' &&
            get(/databases/$(database)/documents/archive_items/$(itemId)).data.is_private == false
          )
        );
      allow delete: if isSAHSUser() || (
        request.auth != null && 
        request.auth.token.email.lower() == resource.data.authorEmail.lower()
      );
    }

    // collections collection: public collections readable by anyone, staff read all
    //
    // Closed alongside archive_items. Leaving this open kept item privacy partly
    // inferable — BrowseArchive reads the whole collection list to build its
    // privacy map, so a private collection's title and membership were public even
    // once its items were not.
    match /collections/{collection} {
      allow read: if resource.data.is_private == false || isSAHSUser();
      allow write: if isSAHSUser();
    }

    // site_settings collection: Anyone can read, only SAHS users can write (or a listed setup admin during initial setup)
    match /site_settings/{document} {
      allow read: if true;
      // The setup clause carried the same defect as the user_roles one: while
      // isSetupComplete() is false it was reachable by any authenticated account,
      // and site_settings is where the setup/appearance documents that define
      // isSetupComplete() themselves live. Restricted to isBootstrapAdmin() for
      // the same reason.
      allow write: if isSAHSUser()
                   || (!isSetupComplete() && isBootstrapAdmin());
    }

    // deployment_config: per-install settings that the app itself must not be
    // able to change — who may run first-run setup, and who the support admins
    // are. Written only by scripts with server credentials
    // (scripts/set-setup-admins.cjs, scripts/set-support-admins.cjs), which
    // bypass these rules; the get()s in the helpers above are privileged too.
    match /deployment_config/{document} {
      allow read, write: if false;
    }

    // The support list is the exception on reads: a museum's staff must be able
    // to see who outside it has admin access. Still never writable from the app.
    match /deployment_config/support {
      allow get: if isSAHSUser();
    }

    // settings collection: Anyone can read, only SAHS users can write
    match /settings/{document} {
      allow read: if true;
      allow write: if isSAHSUser();
    }

    // rooms collection for interactive map: Anyone can read, only SAHS users can write
    match /rooms/{room} {
      allow read: if true;
      allow write: if isSAHSUser();
    }

    // locations collection for interactive map: Anyone can read, only SAHS users can write
    match /locations/{location} {
      allow read: if true;
      allow write: if isSAHSUser();
    }

    // members collection: SAHS curators/admins can manage all, individuals can read their own membership status
    match /members/{email} {
      // `get` was `request.auth != null`. Because documents are keyed by email
      // address, that made this a membership oracle: any signed-in Google account
      // could probe members/{anyone@example.com} and learn whether that person is a
      // member, their status and their renewal date. `list` was already restricted,
      // which is what disguised it — the collection could not be enumerated, but
      // every individual record was directly addressable.
      //
      // The three real callers: AuthContext reads the signed-in user's own record
      // (self); Admin Settings lists them (`list`); MyResearch validates a folder
      // share target (src/pages/MyResearch.tsx:457) — hence isActiveMember(), which
      // is already the precondition for sharing a folder at all.
      allow get: if isSAHSUser()
                 || (request.auth != null && request.auth.token.email.lower() == email.lower())
                 || isActiveMember();
      allow list: if isSAHSUser();
      allow write: if isSAHSUser();
    }

    // Deprecated research_folders subcollection (retained for backward compatibility/read-only safety if needed)
    match /members/{email}/research_folders/{folderId} {
      allow read, write: if isSAHSUser() || (request.auth != null && request.auth.token.email.lower() == email.lower());
    }

    // Deprecated research_notes subcollection (retained for backward compatibility/read-only safety if needed)
    match /members/{email}/research_notes/{itemId} {
      allow read, write: if isSAHSUser() || (request.auth != null && request.auth.token.email.lower() == email.lower());
    }

    // Root-level research_folders: Owners, Collaborators, and SAHS curators/admins can read/write
    match /research_folders/{folderId} {
      allow read: if isSAHSUser() || (
        request.auth != null && (
          (resource.data.ownerEmail != null && resource.data.ownerEmail == request.auth.token.email.lower()) || 
          (resource.data.sharedWith != null && request.auth.token.email.lower() in resource.data.sharedWith)
        )
      );
      // A new folder starts unshared — both MyResearch and ItemDetail create it
      // with `sharedWith: []`. Collaborators are then added one at a time through
      // update, where sharedWithAdditionsAllowed() checks each; allowing a list on
      // create would be a way around that check.
      allow create: if request.resource.data.get('sharedWith', []) == [] && (
        isSAHSUser() || (
          isActiveMember() &&
          request.resource.data.ownerEmail != null &&
          request.resource.data.ownerEmail == request.auth.token.email.lower()
        )
      );
      // Update used to check only who the caller was in the EXISTING document, so a
      // collaborator — anyone in `sharedWith` — could rewrite `ownerEmail` to
      // themselves and `sharedWith` to whatever they liked, and then, as the new
      // "owner", delete the folder. Now:
      //   • staff may change anything, subject to the members-only sharing check;
      //   • the owner may change anything except `ownerEmail`, and may add only
      //     members or staff as collaborators;
      //   • a collaborator may change only the folder's contents — `itemIds`
      //     (MyResearch's add/remove, ItemDetail's bookmark) and `name` /
      //     `description` (the Edit Folder Details button, shown to collaborators
      //     too). Not `ownerEmail`, not `sharedWith`.
      allow update: if sharedWithAdditionsAllowed() && (
        isSAHSUser() || (
          isActiveMember() && (
            (resource.data.ownerEmail != null &&
             resource.data.ownerEmail == request.auth.token.email.lower() &&
             request.resource.data.ownerEmail == resource.data.ownerEmail) ||
            (resource.data.sharedWith != null &&
             request.auth.token.email.lower() in resource.data.sharedWith &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['itemIds', 'name', 'description']))
          )
        )
      );
      allow delete: if isSAHSUser() || (
        isActiveMember() && 
        resource.data.ownerEmail != null &&
        resource.data.ownerEmail == request.auth.token.email.lower()
      );
    }

    // Root-level research_notes: Owners can read/write; Collaborators can read if note is not private
    match /research_notes/{noteId} {
      allow read: if isSAHSUser() || (
        request.auth != null && (
          (resource.data.ownerEmail != null && resource.data.ownerEmail == request.auth.token.email.lower()) || (
            resource.data.isPrivate != null &&
            resource.data.isPrivate == false && 
            resource.data.folderId != null &&
            resource.data.folderId != 'global' &&
            isFolderOwnerOrCollaborator(resource.data.folderId, request.auth.token.email.lower())
          )
        )
      );
      allow create: if isSAHSUser() || (
        isActiveMember() && 
        request.resource.data.ownerEmail != null &&
        request.resource.data.ownerEmail == request.auth.token.email.lower()
      );
      allow update: if isSAHSUser() || (
        isActiveMember() && 
        resource.data.ownerEmail != null &&
        resource.data.ownerEmail == request.auth.token.email.lower()
      );
      allow delete: if isSAHSUser() || (
        isActiveMember() && 
        resource.data.ownerEmail != null &&
        resource.data.ownerEmail == request.auth.token.email.lower()
      );
    }

    // notifications collection: Curators and admins can read and update them (to mark as read / dismiss)
    match /notifications/{notificationId} {
      allow read, update: if isSAHSUser();
    }

    // mail collection for Trigger Email extension: Authenticated users can write emails to trigger notifications
    match /mail/{mailId} {
      allow create: if request.auth != null;
    }

    // Root-level personal_pins: Only the owner can read/write their personal pins
    match /personal_pins/{pinId} {
      allow read: if request.auth != null && resource.data.ownerEmail != null && resource.data.ownerEmail == request.auth.token.email.lower();
      allow create: if (isSAHSUser() || isActiveMember()) && request.resource.data.ownerEmail != null && request.resource.data.ownerEmail == request.auth.token.email.lower();
      allow update: if (isSAHSUser() || isActiveMember()) && resource.data.ownerEmail != null && resource.data.ownerEmail == request.auth.token.email.lower() && request.resource.data.ownerEmail != null && request.resource.data.ownerEmail == request.auth.token.email.lower();
      allow delete: if (isSAHSUser() || isActiveMember()) && resource.data.ownerEmail != null && resource.data.ownerEmail == request.auth.token.email.lower();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
