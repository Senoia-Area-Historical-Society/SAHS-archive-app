# The Firestore database this project's archive lives in. Loaded by the Firebase
# CLI for project sahs-archives (deploys and the emulator); read by the web build
# and scripts through scripts/lib/archiveDatabase.cjs. See functions/database.js.
ARCHIVE_DATABASE=sahs-archives

# The project's default Storage bucket, for the scripts that touch Storage
# (scripts/lib/archiveProject.cjs). Not read by the Cloud Functions.
ARCHIVE_STORAGE_BUCKET=sahs-archives.firebasestorage.app

# Sender for folder-sharing invitations (functions/shareInvitation.js). Only the
# updates. subdomain is verified in the Resend account, not the apex.
INVITATION_FROM_ADDRESS=archives@updates.senoiahistory.com
